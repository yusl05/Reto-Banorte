# Clave de la API de Anthropic (el agente/LLM al centro de la arquitectura)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar por el agente
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mongo (docker-compose ya la inyecta; solo úsala si corres el backend fuera de Docker)
MONGO_URL=mongodb://localhost:27017/banorte_credito

PORT=3000
