# Proveedores LLM, en orden de prioridad: Gemini, Grok, HuggingFace, OpenRouter.
# El agente omite proveedores sin API key y hace fallback ante errores de API,
# timeout, cuota agotada o respuestas inválidas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_ENDPOINT=https://router.huggingface.co/v1/chat/completions

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

LLM_TIMEOUT_MS=12000

# Mongo (docker-compose ya la inyecta; solo úsala si corres el backend fuera de Docker)
MONGO_URL=mongodb://localhost:27017/banorte_credito

PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
